<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon definition for Volta's privileged helper.
  Must be copied to Volta.app/Contents/Library/LaunchDaemons/ (see README › "Helper").
  SMAppService.daemon(plistName:) registers it; the user approves it in
  System Settings › General › Login Items & Extensions.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>bashirul.Volta.helper</string>
	<!-- Relative to the app bundle: the helper is the main executable in helper mode. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/Volta</string>
	<key>ProgramArguments</key>
	<array>
		<string>Volta</string>
		<string>--helper</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>bashirul.Volta.helper</key>
		<true/>
	</dict>
	<!-- Run once at boot so charging is restored even if Volta is never opened again. -->
	<key>RunAtLoad</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>bashirul.Volta</string>
	</array>
</dict>
</plist>
